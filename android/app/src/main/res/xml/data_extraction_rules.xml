<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The model (~765 MB) can be downloaded again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
